{
  "$schema": "https://opencode.ai/config.json",
    "default_agent": "film-director",
  "agent": {
    "film-director": {
      "description": "Orchestrates the complete AI film production pipeline.",
      "mode": "primary",
      "prompt": "{file:./.opencode/agents/film-director.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow"
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "servers": {
      "comfy-mcp": {
        "type": "local",
        "command": [
          "/Users/mbensass/.local/share/comfy-mcp/venv/bin/comfy-mcp"
        ],
        "environment": {
          "COMFY_BIN": "/Users/mbensass/.local/share/comfy-mcp/venv/bin/comfy"
        },
        "codemode": false
      }
    }
  }
}
